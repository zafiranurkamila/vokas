# Salin ke .env lalu isi. File .env tidak boleh di-commit.
# Supabase: Project Settings > Database > Connection string > Session pooler (port 5432, IPv4, cocok untuk Railway)
SUPABASE_DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.xxxxxxxxxxxxxxxxxxxx
SUPABASE_DB_PASSWORD=

# Gemini API (Google AI Studio, free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Kunci sederhana untuk endpoint /api/** (kosong = tanpa kunci, hanya untuk lokal)
VOKAS_API_KEY=

# Origin frontend yang boleh memanggil API (pisahkan dengan koma)
CORS_ORIGINS=http://localhost:*,https://*.web.app,https://*.firebaseapp.com

# WhatsApp Cloud API (isi nanti saat webhook diaktifkan)
WA_VERIFY_TOKEN=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_APP_SECRET=
