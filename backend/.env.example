# Salin ke .env lalu isi. File .env tidak boleh di-commit.
# Supabase: Project Settings > Database > Connection string > Session pooler (port 5432, IPv4, cocok untuk Railway)
SUPABASE_DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.xxxxxxxxxxxxxxxxxxxx
SUPABASE_DB_PASSWORD=

# Gemini API (Google AI Studio, free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# cadangan dicoba berurutan bila model utama penuh/lambat/tidak ada (opsional)
GEMINI_MODEL_CADANGAN=gemini-2.5-flash-lite,gemini-flash-latest,gemini-flash-lite-latest,gemini-2.0-flash,gemini-2.0-flash-lite

# Kunci sederhana untuk endpoint /api/** (kosong = tanpa kunci, hanya untuk lokal)
VOKAS_API_KEY=

# Origin frontend yang boleh memanggil API (pisahkan dengan koma)
CORS_ORIGINS=http://localhost:*,https://*.web.app,https://*.firebaseapp.com

# WhatsApp Cloud API (isi nanti saat webhook diaktifkan)
WA_VERIFY_TOKEN=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_APP_SECRET=

# Twilio WhatsApp Sandbox (console.twilio.com). Tidak butuh akun developer Meta.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# URL webhook persis seperti diisi di konsol Twilio, untuk cek tanda tangan
TWILIO_WEBHOOK_URL=https://vokas-backend.onrender.com/webhook/twilio

# BRIAPI SNAP BI sandbox (developers.bri.co.id > Aplikasi Saya). Jangan pernah di-commit.
BRI_BASE_URL=https://sandbox.partner.api.bri.co.id
BRI_CLIENT_ID=
BRI_CLIENT_SECRET=
# isi private key PKCS#8 dalam satu baris, ganti baris baru dengan 

BRI_PRIVATE_KEY=
BRI_PARTNER_ID=
# X-PARTNER-ID dan CHANNEL-ID diberikan BRI untuk aplikasimu
BRI_CHANNEL_ID=
BRI_PATH_MUTASI=/snap/v1.1/bank-statement

# Email laporan harian (settlement QRIS) dan bulanan. Contoh Brevo (gratis 300 email/hari):
# SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, SMTP_USER=login SMTP Brevo, SMTP_PASS=SMTP key
# MAIL_FROM harus alamat pengirim yang sudah diverifikasi di provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
